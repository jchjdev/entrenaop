{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EntrenaOP Chrome · puerto fijo",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "templateFor": "lib",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-hostname=localhost",
        "--web-port=55554"
      ]
    },
    {
      "name": "EntrenaOP App · dispositivo seleccionado",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart"
    },
    {
      "name": "EntrenaOP Avisos · Android Dev",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/config/firebase_dev.json"
      ]
    },
    {
      "name": "EntrenaOP Compras · móvil debug Dev",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "osx": {
        "env": {
          "FLUTTER_LLDB_DEBUGGING": "false"
        }
      },
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/.env.revenuecat-dev.json"
      ]
    },
    {
      "name": "EntrenaOP App · rendimiento (profile)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    }
  ]
}
